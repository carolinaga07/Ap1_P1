@page "/libro/edit/{LibroId:int}"
@inject LibrosService Service
@inject NavigationManager Navigation

<PageTitle>Edit</PageTitle>
<EditForm Model="libro" OnValidSubmit="Modificar">
<DataAnnotationsValidator />
                    
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header text-center">
            <h5 class="card-title">Editar Libro</h5>
        </div>
        <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">Titulo</label>
                        <InputText class="form-control" @bind-Value="libro.Titulo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Autor</label>
                        <InputText class="form-control" @bind-Value="libro.Autor" />
                    </div>

                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a href="/libros" class="btn btn-secondary">Cancelar</a>
                
            }
        </div>
    </div>
</div
</EditForm>
@code {
    [Parameter]
    public int LibroId{ get; set; }

    private Libros? libro;

    protected override async Task OnInitializedAsync()
    {
        libro = await Service.Buscar(LibroId);
    }

    private async Task Guardar()
    {
        bool exito = await Service.Guardar(libro!);
        if (exito)
        {
            Navigation.NavigateTo("/libros");
        }
    }
}
