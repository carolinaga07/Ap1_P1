@page "/libro/edit/{LibroId:int}"
@rendermode InteractiveServer
@inject LibrosService Service
@inject NavigationManager Navigation
@inject ToastService toastService

<PageTitle>Edit</PageTitle>
<EditForm Model="libro" OnValidSubmit="Modificar" FormName="editarLibro">
<DataAnnotationsValidator />
                    
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header text-center">
            <h5 class="card-title">Editar Libro</h5>
        </div>
        <div class="card-body">

                    <div class="mb-3">
                    <label class="form-label"><strong>LibroId</strong></label>
                    <InputNumber class="form-control" @bind-Value="libro.LibroId" readonly></InputNumber>
                    </div>

                    <div class="mb-3">
                     <label class="form-label">Titulo</label>
                        <InputText class="form-control" @bind-Value="libro.Titulo" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Autor</label>
                        <InputText class="form-control" @bind-Value="libro.Autor" />
                    </div>

                    <div class="mb-3">
                    <label class="form-label">Año</label>
                    <InputNumber class="form-control" @bind-Value="libro.AnioPublicacion" ></InputNumber>
                    </div>
                    <div class="card-footer text-center mt-2">
                        <a href="/libros" class="btn btn-secondary"><span class="bi bi-arrow-left"></span>Volver</a>
                        <button type="submit" class="btn btn-primary bi bi-floppy">Guardar</button>

                    </div>
                  </div>
              </div>
         </div>
</EditForm>


@code {
    [Parameter]
    public int LibroId{ get; set; }

    private Libros libro = new Libros();

    protected override async Task OnInitializedAsync()
    {
        var buscar = await Service.Buscar(LibroId);
        buscar.OnSuccess(resultado =>
        {
            if(resultado != null)
            {
                libro = resultado;
            }   
        });

        buscar.OnFailure(() =>
        {
            toastService.ShowError("No se pudo encontrar el libro");
        });
    }

    private async Task Modificar()
    {
        var titulo = await Service.ExisteTitulo(libro.Titulo, LibroId);
        bool existe = false;
        titulo.OnSuccess(resultado =>
        {
            existe = resultado;
        });
        titulo.OnFailure(() =>
        {
            toastService.ShowError("No se pudo verificar el titulo");
        });

        if (existe)
        {
            toastService.ShowError("Ya existe un libro con ese titulo");
            return;
        }

        var modificar = await Service.Guardar(libro);
        modificar.OnSuccess(() =>
        {
            toastService.ShowSuccess("Libro actualizado correctamente");
            Navigation.NavigateTo("/libros");
        });
        modificar.OnFailure(() =>
        {
            toastService.ShowError("No se pudo actualizar el libro");
        });
    }
}
