@page "/libros"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject LibrosService service

<PageTitle>Index</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between aling-items-center">
            <h5 class="card-title">Libros</h5>
            <a href="/libros/crear" class="btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span> Crear
            </a>
        </div>

        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled> Elija una opcion</option
                            <option value="Titulo">Titulo</option>
                            <option value="Autor">Autor</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
                <div class="col-3">
                    <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise" @onclick="Restablecer"></button>
                </div>
            </div>

            <table class="table table-hover text-center mt-3">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Titulo</th>
                        <th>Autor</th>
                        <th>Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var libro in ListaLibros)
                    {
                        <tr>
                            <td>@libro.LibroId</td>
                            <td>@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td>
                                <a href="/libros/editar/@libro.LibroId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                                <a href="/libros/eliminar/@libro.LibroId" class="btn btn-outline-danger bi bi-trash"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <label><strong>Cantidad:</strong> @ListaLibros.Count</label>
        </div>
    </div>
</div>

@code {
    public List<Libros> ListaLibros { get; set; } = new();
    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await service.GetList(l => true);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() == "") return;

        if(Filtro == "Titulo")
        {
            ListaLibros = await service.GetList(l => l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
        }
        else if(Filtro == "Autor")
        {
            ListaLibros = await service.GetList(l => l.Autor.ToLower().Contains(ValorFiltro.ToLower()));
        }
    }

    private async Task Restablecer()
    {
        ListaLibros = await service.GetList(l => true);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
        
    }
}
