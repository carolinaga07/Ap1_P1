@page "/prestamos/edit/{PrestamoId:int}"
@rendermode InteractiveServer
@inject PrestamoService Service
@inject NavigationManager Navigation
@inject ToastService toastService

<PageTitle>Edit</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Libro</h5>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label"><strong>PrestamoId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Prestamo.PrestamoId" readonly></InputNumber>
                </div>

                <div class="mb-3">
                    <label class="form-label">id del estudiante</label>
                    <InputNumber class="form-control" @bind-Value="Prestamo.EstudianteId" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Direccion</label>
                    <InputText class="form-control" @bind-Value="estudiante.Direccion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="estudiante.Email"></InputText>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fecha de nacimiento</label>
                    <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento"></InputDate>
                </div>

                <div class="card-footer text-center mt-2">
                    <a href="/estudiantes" class="btn btn-secondary"><span class="bi bi-arrow-left"></span>Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy">Guardar</button>

                </div>
            </div>
        </div>
    </div>
</EditForm>


@code {
    [Parameter]
    public int PrestamoId { get; set; }

    private PrestamoLibro Prestamo = new();

    protected override async Task OnInitializedAsync()
    {
        Prestamo = await Service.Buscar(PrestamoId);
    }

    private async Task Modificar()
    {
        if (await Service.ExisteNombre(estudiante!.Nombres!, EstudianteId))
        {
            toastService.ShowError("Ya existe un es con ese nombre.");
            return;
        }

        bool exito = await Service.Guardar(Prestamo!);
        if (exito)
        {
            toastService.ShowSuccess(" Prestamo actualizado correctamente");

            await Task.Delay(1500);
            Navigation.NavigateTo("/prestamos");
        }
    }
}
