@page "/prestamos/edit/{PrestamoId:int}"
@rendermode InteractiveServer
@inject PrestamoService prestamoService
@inject EstudiantesService estudiantesService
@inject LibrosService librosService
@inject NavigationManager Navigation
@inject ToastService toastService

<PageTitle>Edit</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Prestamo</h5>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control" @bind-Value="Prestamo.EstudianteId">
                        <option value="0">Elija una opcion</option>
                        @foreach(var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control" @bind-Value="Prestamo.LibroId">
                        <option value="0">Elija una opcion</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo"></InputDate>
                </div>

                <div class="card-footer text-center mt-2">
                    <a href="/prestamos" class="btn btn-secondary"><span class="bi bi-arrow-left"></span>Volver</a>
                    <button type="button" class="btn btn-outline-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</button>
                    <button type="submit" class="btn btn-primary bi bi-floppy">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminacion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (Prestamo != null && Prestamo.Estudiantes != null)
                {
                    <p>Eliminar el prestamo del libro <strong>@Prestamo.Libros.Titulo</strong> a <strong>@Prestamo.Estudiantes.Nombres</strong>?</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="ConfirmarEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PrestamoId { get; set; }

    private PrestamoLibro Prestamo { get; set; } = new PrestamoLibro();
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        var prestamoResult = await prestamoService.Buscar(PrestamoId);

        prestamoResult.OnSuccess(resultado =>
        {
            if (resultado != null)
            {
                Prestamo = resultado;
            }
        });

        prestamoResult.OnFailure(() =>
        {
            toastService.ShowError("No se pudo encontrar el préstamo.");
        });

        var estudiantesResult = await estudiantesService.GetList(e => e.EstudianteId > 0);

        estudiantesResult.OnSuccess(lista =>
        {
            ListaEstudiantes = lista;
        });

        estudiantesResult.OnFailure(() =>
        {
            toastService.ShowError("No se pudieron cargar los estudiantes.");
        });

        var librosResult = await librosService.GetList(l => l.LibroId > 0);

        librosResult.OnSuccess(lista =>
        {
            ListaLibros = lista;
        });

        librosResult.OnFailure(() =>
        {
            toastService.ShowError("No se pudieron cargar los libros.");
        });
    }

    private async Task Modificar()
    {
        if (Prestamo == null)
            return;

        if (await prestamoService.EstudianteTienePrestamo(
            Prestamo.EstudianteId, Prestamo.PrestamoId))
        {
            toastService.ShowError("Este estudiante ya tiene un préstamo activo.");
            return;
        }

        if (await prestamoService.LibroEstaPrestado(
            Prestamo.LibroId, Prestamo.PrestamoId))
        {
            toastService.ShowError("Ese libro ya está prestado.");
            return;
        }

        var resultado = await prestamoService.Guardar(Prestamo);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha modificado correctamente el préstamo.");
            Navigation.NavigateTo("/prestamos");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError("No se ha podido modificar el préstamo.");
        });
    }

    private async Task ConfirmarEliminar()
    {
        var resultado = await prestamoService.Eliminar(Prestamo.PrestamoId);

        resultado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Prestamo eliminado correctamente.");
            Navigation.NavigateTo("/prestamos");
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError("no se pudo eliminar el prestamo");
        });
    }
}
