@page "/prestamos"

@inject PrestamoService prestamoService
@inject ToastService toastService

<PageTitle>Registro de Prestamos</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de Prestamos</h5>
            <a href="/prestamos/create" class="btn btn-primary"><span class="bi bi mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Libro">Libro</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                <QuickGrid Items="ListaPrestamos.AsQueryable()" Class="table table-hover">
                    <PropertyColumn Property="p => p.PrestamoId" Title="PrestamoId" Sortable="true" />
                    <PropertyColumn Property="p => p.Estudiantes.Nombres" Title="Estudiante" Sortable="true" />
                    <PropertyColumn Property="p => p.Libros.Titulo" Title="Libro" Sortable="true" />
                    <PropertyColumn Property="p => p.FechaPrestamo" Title="Fecha Prestamo" Sortable="true" />
                    <PropertyColumn Property="p => p.FechaDevolucion" Title="Fecha Devolucion" Sortable="true" />
                    <TemplateColumn title="Opciones">
                        <a href="/prestamos/edit/@context.PrestamoId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                        @if (context.FechaDevolucion == null)
                        {
                            <a href="/devoluciones/create/@context.PrestamoId" class="btn btn-outline-success bi bi-box-arrow-in-left" title="Registrar devolucion"></a>
                        }
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <label>Cantidad: @ListaPrestamos.Count()</label>
            <label>Promedio de dias prestados: @PromedioDias.ToString("N1")</label>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PrestamoId { get; set; }

    public List<PrestamoLibro> ListaPrestamos { get; set; } = new();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public PrestamoLibro? PrestamoAEliminar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CargarPrestamos(p => p.PrestamoId > 0);
    }

    private async Task CargarPrestamos(Expression<Func<PrestamoLibro, bool>> criterio)
    {
        var resultado = await prestamoService.GetList(criterio);

        resultado.OnSuccess(lista =>
        {
            ListaPrestamos = lista;
        });

        resultado.OnFailure(() =>
        {
            toastService.ShowError("No se pudieron cargar los prestamos.");
        });
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() == "")
        {
            await CargarPrestamos(p => p.PrestamoId > 0);
            return;
        }

        if (Filtro == "Estudiante")
        {
            await CargarPrestamos(p =>
                p.Estudiantes.Nombres.ToLower()
                    .Contains(ValorFiltro.ToLower()));
        }
        else if (Filtro == "Libro")
        {
            await CargarPrestamos(p =>
                p.Libros.Titulo.ToLower()
                    .Contains(ValorFiltro.ToLower()));
        }
    }

    private double PromedioDias => ListaPrestamos.Any(p => p.FechaDevolucion != null)
        ? ListaPrestamos
            .Where(p => p.FechaDevolucion != null)
            .Average(p => (p.FechaDevolucion.Value.DayNumber - p.FechaPrestamo.DayNumber))
        : 0;  
}
