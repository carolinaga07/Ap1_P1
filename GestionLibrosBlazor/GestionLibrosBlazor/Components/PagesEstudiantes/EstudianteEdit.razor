@page "/estudiante/edit/{EstudianteId:int}"
@rendermode InteractiveServer
@inject EstudiantesService Service
@inject NavigationManager Navigation
@inject ToastService toastService

<PageTitle>Edit</PageTitle>
<EditForm Model="estudiante" OnValidSubmit="Modificar" FormName="editarEstudiante">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Libro</h5>
            </div>
            <div class="card-body">
                @*Id*@
                <div class="mb-3">
                    <label class="form-label"><strong>EstudianteId</strong></label>
                    <InputNumber class="form-control" @bind-Value="estudiante.EstudianteId" readonly></InputNumber>
                </div>
                @*Nombres*@
                <div class="mb-3">
                    <label class="form-label">Nombres</label>
                    <InputText class="form-control" @bind-Value="estudiante.Nombres" />
                </div>
                @*Direccion*@
                <div class="mb-3">
                    <label class="form-label">Direccion</label>
                    <InputText class="form-control" @bind-Value="estudiante.Direccion" />
                </div>
                @*Email*@
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="estudiante.Email"></InputText>
                </div>
                @*Fecha de nacimiento*@
                <div class="mb-3">
                    <label class="form-label">Fecha de nacimiento</label>
                    <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento"></InputDate>
                </div>
                @*Footer*@
                <div class="card-footer text-center mt-2">
                    <a href="/estudiantes" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>

                </div>
            </div>
        </div>
    </div>
</EditForm>


@code {
    [Parameter]
    public int EstudianteId { get; set; }

    private Estudiantes estudiante = new Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        var buscar = await Service.Buscar(EstudianteId);
        buscar.OnSuccess(resultado =>
        {
            if (resultado != null)
            {
                estudiante = resultado;
            }
        });
        buscar.OnFailure(() =>
        {
            toastService.ShowError("No se pudo encontrar el estudiante");
        });
    }

    private async Task Modificar()
    {
        var nombre = await Service.ExisteNombre(estudiante.Nombres, EstudianteId);
        bool existe = false;
        bool verificacion = false;

        nombre.OnSuccess(resultado =>
        {
            existe = resultado;
            verificacion = true;
        });
        nombre.OnFailure(() =>
        {
            toastService.ShowError("No se pudo verificar el nombre");
        });
        if(!verificacion){ return; }

        if (existe)
        {
            toastService.ShowError("ya existe un estudiante con ese nombre");
            return;
        }
        var modificar = await Service.Guardar(estudiante);

        modificar.OnSuccess(() =>
        {
            toastService.ShowSuccess("Estudiante actualizado correctamente");
            Navigation.NavigateTo("/estudiantes");
        });
        modificar.OnFailure(() =>
        {
            toastService.ShowError("No se pudo actualizar el estudiante");
        });
    }
}
