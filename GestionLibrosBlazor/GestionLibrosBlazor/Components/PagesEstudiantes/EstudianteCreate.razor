@page "/estudiantes/create"
@rendermode InteractiveServer
@inject EstudiantesService Service
@inject NavigationManager Navigation
@inject ToastService toastService

<PageTitle>Crear Estudiante</PageTitle>
<EditForm Model="estudiante" OnValidSubmit="Guardar" FormName="crearEstudiante">
    <DataAnnotationsValidator />
   
    <div class="container">
       <div class="card shadow-lg">
          <div class="card-header text-center">
            <h5 class="card-title">Crear </h5>
           </div>
        
           <div class="card-body">
                
                <div class="mb-3">
                    <label class="form-label">EstudianteId</label>
                    <InputNumber  class="form-control" @bind-Value="estudiante.EstudianteId" readonly > </InputNumber>
                </div>
               
               
               <div class="mb-3">
                    <label class="form-label">Nombres</label>
                    <InputNumber class="form-control" @bind-Value="estudiante.EstudianteId" />
                </div>

                 <div class="mb-3">
                    <label class="form-label">Direccion</label>
                    <InputText class="form-control" @bind-Value="estudiante.Direccion" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputNumber class="form-control" @bind-Value="estudiante.Email" ></InputNumber>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fecha de nacimiento</label>
                    <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento"></InputDate>
                </div>
                <div class="card-footer text-center mt-2">
                    <a href="/estudiantes" class="btn btn-secondary"><span class="bi bi-arrow-left"></span>Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floopy">Guardar</button>

                </div>
            </div>
         </div>
       </div>
</EditForm>


@code{

    private Estudiantes estudiante = new();
   

    private async Task Guardar()
    {
        if(await Service.ExisteNombre(estudiante.Nombres!))
        {
            toastService.ShowError("Ya existe un estudiante con ese nombre.");
            return;
        }
        bool exito = await Service.Guardar(estudiante);
        if (exito)
        {
            toastService.ShowSuccess("Estudiante guardado correctamente.");
            Navigation.NavigateTo("/estudiantes");
        }

    }

   
}
