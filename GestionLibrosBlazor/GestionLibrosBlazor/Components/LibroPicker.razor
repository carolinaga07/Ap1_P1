@using Microsoft.AspNetCore.Components.Rendering

<div class="col-auto input-group align-items-center">
    <label class="col-form-label input-group-text">Seleccione el libro:</label>

    <InputSelect class="form-control form-select" @bind-Value="LibroId">
        <option disabled value="0">-- selecciona un libro --</option>
        @foreach (var libro in Libros)
        {
            <option value="@libro.LibroId">@libro.LibroId - @libro.Titulo (Stock Actual: @libro.Cantidad)</option>
        }
    </InputSelect>
    <label class="col-form-label input-group-text">Cantidad:</label>
    <InputNumber class="form-control" id="quantuty-input" @bind-Value="CantidadSeleccionada" min="1" />
    <button type="button" class="btn btn-outline-success bi bi-plus" @onclick="TriggerSelection">Agregar</button>
</div>

@if(ErrorMessage != null)
{
    <div class="alert alert-danger mt-2" role="alert">
        @ErrorMessage
    </div>
}    

@code
{
    [Parameter]
    public int LibroId { get; set; }
    public Libros? libro { get; set; }
    public List<Libros> Libros { get; set; } = new List<Libros>();
    public int CantidadSeleccionada { get; set; } = 1;
    public EventCallback<(Libros Libro, int Cantidad)> OnLibroSelected { get; set; }
    private string? ErrorMessage { get; set; } = null;

    private async Task TriggerSelection()
    {
        ErrorMessage = null;
        if(LibroId > 0)
        {
            var libroSeleccionado = Libros.Single(l => l.LibroId == LibroId);
            if(CantidadSeleccionada <= 0)
            {
                ErrorMessage = "La cantidad debe ser mayor a cero";
                return;
            }
            if(CantidadSeleccionada > libroSeleccionado.Cantidad)
            {
                ErrorMessage = $"No hay suficiente stock disponible. Stock actual: {libroSeleccionado.Cantidad}";
                return;
            }
            await OnLibroSelected.InvokeAsync((libroSeleccionado, CantidadSeleccionada));
        }
        else
        {
            ErrorMessage = "hubo un error, seleccione un libro valido";
        }
    }

   

}
