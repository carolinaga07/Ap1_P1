@page "/entradas"
@rendermode InteractiveServer
@inject EntradasService entradasService
@inject ToastService toastService

<PageTitle>Index Entrada</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title">Registro de Entradas</h5>
            <a href="/entradas/create" class="btn btn-primary bi bi-plus-square"> Crear</a>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="Concepto">Concepto</option>
                        <option value="Fecha">Fecha</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar concepto" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-3">
                    <label class="col-form-label">Desde</label>
                    <InputDate class="form-control" @bind-Value="Desde" />
                </div>
                <div class="col-3">
                    <label class="col-form-label">Hasta</label>
                    <InputDate class="form-control" @bind-Value="Hasta" />
                </div>
            </div>
            <QuickGrid Items="ListaEntradas.AsQueryable()" class="table table-hover text-center mt-3">
                <PropertyColumn Property="e => e.EntradaId" title="EntradaId" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Fecha" title="Fecha" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Concepto" title="Concepto" Sortable="true"></PropertyColumn>
                <PropertyColumn Property="e => e.Total" title="Total" Sortable="true"></PropertyColumn>
                <TemplateColumn title="Opciones">
                    <a href="/entradas/edit/@context.EntradaId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <label>Cantidad:@ListaEntradas.Count</label>
            <label>Total de libros:@ListaEntradas.Sum(e => e.Total) </label>
        </div>
    </div>
</div>
@code {
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateOnly? Desde { get; set; }
    public DateOnly? Hasta { get; set; }
    public List<Entradas> ListaEntradas { get; set; } = new List<Entradas>();

    protected override async Task OnInitializedAsync()
    {
        await CargarEntradas(e => e.EntradaId > 0);
    }

    private async Task CargarEntradas(Expression<Func<Entradas, bool>> criterio)
    {
        var resultado = await entradasService.GetList(criterio);
        resultado.OnSuccess(lista => ListaEntradas = lista);
        resultado.OnFailure(() => toastService.ShowError("No se pudieron cargar las entradas"));
    }

    private async Task Buscar()
    {
        if (Filtro == "Fecha")
        {
            if (!Desde.HasValue || !Hasta.HasValue)
            {
                toastService.ShowError("Debe elegir las dos fechas");
                return;
            }

            var desde = Desde.Value;
            var hasta = Hasta.Value;

            await CargarEntradas(e => e.Fecha >= desde && e.Fecha <= hasta);
        }
        else if (Filtro == "Concepto" && !string.IsNullOrWhiteSpace(ValorFiltro))
        {
            await CargarEntradas(e => e.Concepto.ToLower().Contains(ValorFiltro.ToLower()));
        }
    }
}
