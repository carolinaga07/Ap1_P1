@page "/entradas/create"
@rendermode InteractiveServer
@inject EntradasService entradasService
@inject LibrosService librosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle> Crear Entrada</PageTitle>
<EditForm Model="Entrada" OnValidSubmit="Guardar">
<DataAnnotationsValidator />
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header text-center">
            <h5 class="card-title">Crear Entrada</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">EntradaId</label>
                <InputNumber class="form-control" @bind-Value="Entrada.EntradaId" readonly></InputNumber>
            </div>
            <div class="mb-3">
                <label class="form-label">Fecha</label>
                <InputDate class="form-control" @bind-Value="Entrada.Fecha"></InputDate>
                <ValidationMessage For="@(() => Entrada.Fecha)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Concepto</label>
                <InputText class="form-control" @bind-Value="Entrada.Concepto"></InputText>
                <ValidationMessage For="@(() => Entrada.Concepto)" />
            </div>
            <div class="border border-success p-3 mt-3">
                <h5>Detalle de la Entrada</h5>
                <LibroPicker Libros="ListaLibros" OnLibroSelected="HandleLibroSelected" />
                <hr />
                <QuickGrid Items="Entrada.EntradasDetalles.AsQueryable()" class="table table-light text-center">
                    <TemplateColumn title="Libro">
                        @TituloLibro(context.LibroId)
                    </TemplateColumn>
                    <PropertyColumn Property="d => d.Cantidad" title="Cantidad" />
                    <TemplateColumn Title="Remover">
                        <button type="button" class="btn btn-outline-danger bi bi-trash" @onclick="() => Quitar(context)"></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>
            <div class="row mt-2">
                <div class="col-6 offset-6">
                    <div class="mb-3">
                        <label class="form-label">Total</label>
                        <label class="form-control text-end">@Entrada.Total</label>
                        <ValidationMessage For="(() => Entrada.Total)" />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-center mt-2">
            <a href="/entradas" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
            <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
        </div>
    </div>
</div>
</EditForm>
@code {
    public Entradas Entrada { get; set; } = new Entradas();
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await librosService.GetList(l => l.LibroId > 0);
        Entrada.Fecha = DateOnly.FromDateTime(dateTime.Today);
    }

    private string TituloLibro(int libroId)
    {
        return ListaLibros.FirstOrDefault(l => l.LibroId == libroId).Titulo ?? string.Empty;
    }

    private Task HandleLibroSelected((Libros Libro, int Cantidad) selection)
    {
        var existente = Entrada.EntradasDetalles.FirstOrDefault(d => d.LibroId == selection.Libro.LibroId);
        if(existente != null)
        {
            existente.Cantidad += selection.Cantidad;
        }
        else
        {
            Entrada.EntradasDetalles.Add(new EntradasDetalle { LibroId = selection.Libro.LibroId, Cantidad = selection.Cantidad });
        }
        Entrada.Total = Entrada.EntradasDetalles.Sum(d => d.Cantidad);
    }

    private void Quitar(EntradasDetalle detalle)
    {
        Entrada.EntradasDetalles.Remove(detalle);
        Entrada.Total = Entrada.EntradasDetalles.Sum(d => d.Cantidad);
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(Entrada.Concepto))
        {
            toastService.ShowError("El concepto es requerido.");
            return;
        }
        bool guardado = await entradasService.Guardar(Entrada);
        if (guardado)
        {
            toastService.ShowSuccess("Entrada guardada correctamente");
            navigationManager.NavigateTo("/entradas");
        }
        else
        {
            toastService.ShowError("No se ha podido guardar la entrada");
        }
    }
}
